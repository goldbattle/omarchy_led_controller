#!/usr/bin/env python3
"""Tiny front-end over the OpenRGB client (talks to the `openrgb --server` user service).

All state lives in ~/.config/led.json; every command updates it, then sync() makes the
hardware match, so the panel, right-click, terminal and the night timer all obey the
same per-device switches. Commands print the resulting state as JSON.

  led state
  led set [RRGGBB|theme] [-m static|breathing|rainbow|flux] [-b 0-100] [-g 1.0-4.0]
  led on | led off
  led device NAME on|off          per-device power switch
  led schedule '{"auto_off": true, "off": "22:00", "on": "09:00", "location": [lat, lon]}'
  led restart                     restart the OpenRGB server (re-detects devices, re-applies)
  led tick                        run every minute by led-schedule.timer
  led watch                       run by led-idle.service: dark while all monitors are off
  led restore                     run at login by openrgb.service
"""
import argparse, json, math, os, re, shlex, subprocess, sys, time
from datetime import datetime, timezone
from pathlib import Path

# Each device names its modes differently; first match wins.
MODES = {
    "static":    ["Direct", "Static"],
    "breathing": ["Breathing", "Color Pulse", "Pulsing"],
    "rainbow":   ["Spectrum Cycle", "Rainbow Wave", "Rainbow", "Color Shift"],
    "off":       ["Off"],
}
CONFIG = Path.home() / ".config/led.json"
DEFAULTS = {"color": "8000FF", "mode": "static", "brightness": 100, "power": True,
            "disabled": [],        # per-device switch off
            "auto_off": False, "off": "22:00", "on": "09:00",
            "idle_off": True,      # all LEDs off while every monitor is DPMS-off (screensaver -> black)
            "gamma": 2.8,          # screen->LED colour depth; 2.2 = textbook sRGB, higher = deeper
            "location": [37.77, -122.42]}  # flux follows the sun here (default San Francisco)
# flux: sun elevation (degrees) -> colour temperature (K). Day white, sunset warm,
# dusk candlelight, then fading to pure red ("darkroom") by nautical dusk.
FLUX = [(6, 6500), (0, 3400), (-3, 2700), (-6, 1900)]
DARKROOM = -12
# {"window": last seen in-window bool, "held": schedule is holding lights off,
#  "idle": monitors are off (set by `led watch`)}.
# In /run so a reboot forgets it and the next tick re-evaluates.
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "led-schedule.json"
RT_DEFAULT = {"window": None, "held": False, "idle": False}
THEME = Path.home() / ".local/state/omarchy/current/theme"
HHMM = re.compile(r"([01]\d|2[0-3]):[0-5]\d")


def openrgb(*args):
    r = subprocess.run(["openrgb", *args], capture_output=True, text=True, timeout=20)
    return r.stdout + r.stderr  # exit code is 0 even on errors; callers check the text


RAINBOWISH = ["FF0000", "0000FF", "00FF00"]  # for "rainbow" on devices that can only shift between N colours


def apply(args):
    out = openrgb(*args)
    if m := re.search(r"between (\d+) and", out):
        # some modes want N colours: repeat ours (Commander "Color Pulse" = 2), or for
        # colourless rainbow fallbacks (H150i "Color Shift" = 2) hand it contrasting ones
        n = int(m[1])
        if "-c" in args:
            i = args.index("-c") + 1
            args[i] = ",".join([args[i]] * n)
        else:
            args += ["-c", ",".join((RAINBOWISH * n)[:n])]
        out = openrgb(*args)
    if re.search(r"error|wrong|invalid|not found", out, re.I):
        sys.exit(out.strip())


def parse(text):
    devs = []
    for line in text.splitlines():
        if m := re.match(r"^(\d+): (.+)$", line):
            devs.append({"index": int(m[1]), "name": m[2].strip(), "type": "", "modes": []})
        elif devs and (m := re.match(r"^\s+(Type|Modes):\s+(.*)$", line)):
            if m[1] == "Type":
                devs[-1]["type"] = m[2].strip()
            else:  # [Active] 'Two Words' Plain  -> brackets mark the active mode
                devs[-1]["modes"] = shlex.split(m[2].replace("[", "").replace("]", ""))
    return devs


def pick(dev, intent):
    return next((m for m in MODES[intent] if m in dev["modes"]), None)


def build(devs, color, intent, brightness, gamma=1.0):
    # Hex colours are screen (gamma-encoded) values but LED PWM is linear: without this, pastels
    # like a theme accent wash out to near-white. Pure colours (FF0000, ...) are unaffected.
    r, g, b = (round((int(color[i:i + 2], 16) / 255) ** gamma * 255 * brightness / 100) for i in (0, 2, 4))
    hexc = f"{r:02X}{g:02X}{b:02X}"
    calls = []
    for d in devs:
        mode, c = pick(d, intent), hexc
        if intent == "off" and not mode:  # no hardware Off: paint it black
            mode, c = pick(d, "static"), "000000"
        if not mode:
            continue
        args = ["-d", str(d["index"]), "-m", mode]
        if intent != "rainbow" and mode != "Off":
            args += ["-c", c]
        calls.append(args)
    return calls


def in_window(now, off, on):
    """now/off/on are "HH:MM"; the window may wrap past midnight."""
    if off == on:
        return False
    return off <= now < on if off < on else now >= off or now < on


def sun_elevation(t, lat, lon):
    """Degrees above the horizon at UTC datetime `t` (USNO low-precision formulas, ~0.1 deg)."""
    d = (t - datetime(2000, 1, 1, 12, tzinfo=timezone.utc)).total_seconds() / 86400
    g = math.radians(357.529 + 0.98560028 * d)
    q = 280.459 + 0.98564736 * d
    L = math.radians(q + 1.915 * math.sin(g) + 0.020 * math.sin(2 * g))
    e = math.radians(23.439 - 0.00000036 * d)
    ra = math.atan2(math.cos(e) * math.sin(L), math.cos(L))
    dec = math.asin(math.sin(e) * math.sin(L))
    ha = math.radians((18.697374558 + 24.06570982441908 * d) * 15 + lon) - ra
    lat = math.radians(lat)
    return math.degrees(math.asin(math.sin(lat) * math.sin(dec) + math.cos(lat) * math.cos(dec) * math.cos(ha)))


def kelvin(k):
    """Colour temperature -> sRGB (Tanner Helland's fit, good for 1000-40000K)."""
    t = k / 100
    r = 255 if t <= 66 else 329.698727446 * (t - 60) ** -0.1332047592
    g = 99.4708025861 * math.log(t) - 161.1195681661 if t <= 66 else 288.1221695283 * (t - 60) ** -0.0755148492
    b = 255 if t >= 66 else 0 if t <= 19 else 138.5177312231 * math.log(t - 10) - 305.0447927307
    return [max(0, min(255, round(c))) for c in (r, g, b)]


def flux(el):
    """(RRGGBB, label) for sun elevation `el`: the FLUX curve, then a fade to pure red."""
    pts = FLUX
    if el >= pts[0][0]:
        k = pts[0][1]
    elif el <= pts[-1][0]:
        k = pts[-1][1]
    else:
        (e1, k1), (e0, k0) = next((p, n) for p, n in zip(pts, pts[1:]) if n[0] <= el <= p[0])
        k = k0 + (k1 - k0) * (el - e0) / (e1 - e0)
    rgb = kelvin(k)
    if el < pts[-1][0]:  # past civil dusk: candlelight -> darkroom red
        f = min(1.0, (pts[-1][0] - el) / (pts[-1][0] - DARKROOM))
        rgb = [round(c + (r - c) * f) for c, r in zip(rgb, (255, 0, 0))]
        return "".join(f"{c:02X}" for c in rgb), "red" if f >= 1 else f"{round(k, -2):.0f}K→red"
    return "".join(f"{c:02X}" for c in rgb), f"{round(k, -2):.0f}K"


def flux_now(cfg):
    lat, lon = cfg["location"] or DEFAULTS["location"]  # `or`: older configs stored null
    return flux(sun_elevation(datetime.now(timezone.utc), lat, lon))


def theme_color():
    """The theme accent: the colour the panel swatch and the desktop show. (Not keyboard.rgb:
    some themes override that, e.g. tokyo-night is magenta there but blue everywhere else.)"""
    try:
        if m := re.search(r'^accent\s*=\s*"#([0-9a-fA-F]{6})"', (THEME / "colors.toml").read_text(), re.M):
            return m[1].upper()
    except OSError:
        pass
    return "FFFFFF"


def look(cfg):
    """(colour, mode) to show right now."""
    if cfg["mode"] == "flux":
        return flux_now(cfg)[0], "static"
    return theme_color() if cfg["color"] == "theme" else cfg["color"], cfg["mode"]


def lit(cfg, rt, devs):
    """The one rule for which devices should be on: night/idle darken all, switches gate the rest."""
    if not cfg["power"] or rt["held"] or (rt.get("idle") and cfg["idle_off"]):
        return []
    return [d for d in devs if d["name"] not in cfg["disabled"]]


def screens_off():
    """True when every enabled monitor is DPMS-off (Omarchy blanks them after the lock screen)."""
    try:
        r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=5)
        mons = [m for m in json.loads(r.stdout) if not m.get("disabled")]
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False  # can't tell: never darken on a guess
    return bool(mons) and not any(m.get("dpmsStatus", True) for m in mons)


def watch():
    # ponytail: polls every 2s (hyprctl ~7ms); Hyprland has no DPMS event on socket2 to subscribe to.
    while True:
        off = screens_off()
        rt = load(RUNTIME, RT_DEFAULT)
        if off != bool(rt.get("idle")):
            rt["idle"] = off
            try:
                sync(load(CONFIG, DEFAULTS), rt, parse(openrgb("-ld")))
                save(RUNTIME, rt)
            except SystemExit as e:  # openrgb hiccup: log and retry next poll
                print(f"led watch: {e}", file=sys.stderr, flush=True)
        time.sleep(2)


def load(path, default):
    try:
        return {**default, **json.loads(path.read_text())}
    except (FileNotFoundError, ValueError):
        return dict(default)


def save(path, data):
    path.write_text(json.dumps(data, indent=2) + "\n")


def sync(cfg, rt, devs):
    on = lit(cfg, rt, devs)
    off = [d for d in devs if d not in on]
    color, mode = look(cfg)
    for args in build(on, color, mode, cfg["brightness"], cfg["gamma"]) + build(off, "000000", "off", 100):
        apply(args)
    rt["shown"] = color


def toggle(lst, name, include):
    return sorted(set(lst) | {name}) if include else [n for n in lst if n != name]


def main():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("state", "on", "off", "tick", "restore", "restart", "watch"):
        sub.add_parser(name)
    s = sub.add_parser("set")
    s.add_argument("color", nargs="?", type=lambda c: "theme" if c == "theme" else re.fullmatch(r"#?([0-9a-fA-F]{6})", c)[1].upper())
    s.add_argument("-m", "--mode", choices=["static", "breathing", "rainbow", "flux"])
    s.add_argument("-b", "--brightness", type=int, choices=range(0, 101), metavar="0-100")
    s.add_argument("-g", "--gamma", type=float, metavar="1.0-4.0", help="colour depth")
    d = sub.add_parser("device")
    d.add_argument("name")
    d.add_argument("state", choices=["on", "off"])
    sub.add_parser("schedule").add_argument("json")
    a = p.parse_args()

    if a.cmd == "restart":  # its ExecStartPost runs `led restore`, so just report afterwards
        r = subprocess.run(["systemctl", "--user", "restart", "openrgb.service"], capture_output=True, text=True)
        if r.returncode:
            sys.exit(r.stderr.strip())
        a.cmd = "state"

    if a.cmd == "watch":
        watch()
    cfg = {k: v for k, v in load(CONFIG, DEFAULTS).items() if k in DEFAULTS}
    if cfg["mode"] == "daylight":  # renamed
        cfg["mode"] = "flux"
    rt = load(RUNTIME, RT_DEFAULT)
    devs = parse(openrgb("-ld"))
    names = {d["name"] for d in devs}
    if getattr(a, "name", None) and a.name not in names:
        sys.exit(f"unknown device {a.name!r}; have: {sorted(names)}")

    if a.cmd == "set":
        cfg.update(color=a.color or cfg["color"], mode=a.mode or cfg["mode"], power=True)
        cfg["brightness"] = cfg["brightness"] if a.brightness is None else a.brightness
        if a.gamma is not None:
            if not 1.0 <= a.gamma <= 4.0:
                sys.exit("gamma must be 1.0-4.0")
            cfg["gamma"] = round(a.gamma, 1)
        rt["held"] = False  # touching the lights at night overrides the schedule until morning
    elif a.cmd in ("on", "off"):
        cfg["power"] = a.cmd == "on"
        rt["held"] = rt["held"] and a.cmd == "off"
    elif a.cmd == "device":
        cfg["disabled"] = toggle(cfg["disabled"], a.name, a.state == "off")
    elif a.cmd == "schedule":
        try:
            new = json.loads(a.json)
            loc = new.get("location", cfg["location"])
            ok = (isinstance(new, dict) and isinstance(new.get("auto_off", cfg["auto_off"]), bool)
                  and isinstance(new.get("idle_off", cfg["idle_off"]), bool)
                  and all(HHMM.fullmatch(str(new.get(k, cfg[k]))) for k in ("off", "on"))
                  and isinstance(loc, list) and len(loc) == 2
                  and all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in loc)
                  and -90 <= loc[0] <= 90 and -180 <= loc[1] <= 180)
        except (ValueError, AttributeError):
            ok = False
        if not ok:
            sys.exit('expected {"auto_off": bool, "off": "HH:MM", "on": "HH:MM", '
                     '"idle_off": bool, "location": [lat, lon]} (all keys optional)')
        cfg.update({k: new[k] for k in ("auto_off", "off", "on", "idle_off", "location") if k in new})

    if a.cmd in ("tick", "schedule", "restore"):
        window = cfg["auto_off"] and in_window(time.strftime("%H:%M"), cfg["off"], cfg["on"])
        changed = window != rt["window"]  # act on transitions only, so manual changes stick
        if changed or a.cmd == "restore":
            rt.update(window=window, held=window)
        drifted = look(cfg)[0] != rt.get("shown")  # flux step or theme change
        if a.cmd == "tick" and not changed and not drifted:
            return

    if a.cmd != "state":
        save(CONFIG, cfg)
        sync(cfg, rt, devs)
        save(RUNTIME, rt)  # after sync: a failed apply is retried next tick
    if a.cmd != "tick":
        print(json.dumps({**cfg, "held": rt["held"], "shown": look(cfg)[0], "flux": flux_now(cfg)[1],
                          "devices": devs}))


if __name__ == "__main__":
    main()
